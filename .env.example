# Optional overrides for Docker Compose and local development.
# Copy this file to .env when you need different local values.
POSTGRES_PORT=5432
DB_LOCAL=ecommerce
DB_USERNAME_LOCAL=ecommerce
DB_PASSWORD_LOCAL=ecommerce_local

# Obtain these values from the VNPay sandbox portal. Leave them empty when
# working only with authentication, product, or order features.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
